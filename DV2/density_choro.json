{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 500,
  "height": 400,
  "title":{"text": "Population Density per State/Territory"},
  "projection": {
    "type": "mercator"
  },
  "data":{
    "url": "data/topo/aus_state.json",
    "format":{"type": "topojson", "feature": "ne_50m_admin_1_states_provinces"}
  },
  "transform": [{
    "lookup": "properties.postal",
    "from":{"data":{
        "url": "data/popdensity.csv",
        "format":{"type": "csv"}
        },
        "key":"state",
        "fields":["density(ppl/km2)"]
    }
  }],
  "mark":{"type": "geoshape", "stroke":"black","strokeWidth": 1},
  "encoding": {
    "color":{"field":"density(ppl/km2)", "type": "quantitative", "scale":{"scheme":"orangered", "type": "log"},
  "title":"Ppl/km2", "legend": {
    "orient": "left"
  }},
    "tooltip":[{"field":"properties.postal", "type": "nominal", "title":"State"},
                {"field":"density(ppl/km2)", "type": "quantitative", "title":"Density (people/km2)", "format": ".2f"}]
  }
}