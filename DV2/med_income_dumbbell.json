{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title":{"text": "Median Income Greater City vs Rest of State"},
  "height":300,
  "width":"container",
  "autosize": {
        "type": "fit",
        "contains": "padding"
    },
  "data": {
    "url": "data/median_income_19-23.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "YearSelect",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2019,
        "max": 2023,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {
      "filter": "toNumber(datum.Year) == YearSelect"
    }
  ],
  "encoding": {
    "x": {
      "field": "Median_Income",
      "type": "quantitative",
      "title": "Median Income",
      "scale": {
        "domain": [40000, 80000],
        "zero": false,
        "nice": false
      }
    },
    "y": {
      "field": "state",
      "type": "nominal",
      "title": "State"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#B8B8B8",
        "strokeWidth": 2
      },
      "encoding": {
        "detail": {
          "field": "state",
          "type": "nominal"
        },
        "order": {
          "field": "income",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100
      },
      "encoding": {
        "color": {
          "field": "place",
          "type": "nominal",
          "scale": {
            "domain": ["City", "Rest of State"],
            "range": ["#911a24", "#e6959c"]
          },
          "title": "Area"
        },
        "tooltip": [
          {"field": "state", "type": "nominal"},
          {"field": "place_name", "type": "nominal", "title": "Location"},
          {"field": "Median_Income", "type": "nominal", "title": "Median Income"}
        ]
      }
    }
  ]
}