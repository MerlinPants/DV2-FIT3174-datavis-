{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width":"container",
    "height":400,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },
    "title":{"text": "Australian Population"},
    "data": {
    "url": "data/auspop.csv"
    },
    "mark":"line",
    "encoding": {
        "x":{"field":"quarter", "type": "temporal", "axis":{
            "title": "Quarter"
        }},
        "y":{"field":"Auspop", "type": "quantitative", "axis":{
            "title": "Population"},
        "scale":{"domain": [10000000, 30000000]}}
    }
}