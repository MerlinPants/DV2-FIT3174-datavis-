
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Migration to Australia by Region",
    "anchor": "middle"
  },
  "width": 845,
  "height": 500,
  "projection": {
    "type": "naturalEarth1",
    "scale": 170,
    "center": [30,0]
  },
  "layer": [
    {
      "data": {
        "url": "./data/topo/worldmap.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d8d4cc",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "./data/migrant_CoB_96_25.csv"
      },
      "transform": [
        {
          "filter": "toNumber(datum.Year) === 2025"
        }
      ],
      "mark": "rule",
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "dest_lon"
        },
        "latitude2": {
          "field": "dest_lat"
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "legend": null
        },
        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "Origin region"
          },
          {
            "field": "Year",
            "type": "quantitative",
            "title": "Year"
          },
          {
            "field": "migrant_count",
            "type": "quantitative",
            "title": "Migrants",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "url": "./data/migrant_CoB_96_25.csv"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 0.3,
        "size": 200,
        "stroke":"black",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size":{
          "field":"Count",
          "type": "quantitative",
          "scale":{
            "type": "sqrt"
          },
          "legend": {
            "orient": "right",
            "title": "People",
            "values":[2000000, 4000000, 6000000, 8000000]
          }
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "scale":{
            "range": [
              "#0072B2",
              "#E69F00",
              "#009E73",
              "#D55E00",
              "#CC79A7",
              "#56B4E9",
              "#F0E442",
              "#000000"
            ]
          }
        },
        "tooltip": [
          {
            "field": "region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "Count",
            "type": "quantitative",
            "format": ",",
            "title": "People"
          }
        ]
      }
    },
    {
      "data": {"url": "./data/migrant_CoB_96_25.csv"},
      "transform": [
        {"filter": "toNumber(datum.Year) === 2025"},
        {"calculate": "datum.region === 'Europe' ? datum.lat - 15 : datum.lat", "as": "label_lat"}
      ],
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "dy": -14},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "label_lat", "type": "quantitative"},
        "text": {"field": "region", "type": "nominal"}
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
