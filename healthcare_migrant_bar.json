{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "height":300,
  "width":300,
  "title":{"text":"Healthcare worker proportion"},
  "data": { "url": "data/Healthcare_migrant_prop.csv"},
  "encoding": {
    "y": {"field": "Job", "type":"nominal"}
  },
  "layer": [{
    "mark": "bar",
    "encoding": {
      "x": {
        "aggregate": "sum",
        "field": "prop",
        "type": "quantitative",
        "title": "Proportion",
        "stack":  "normalize"
      },
      "color": {
        "field": "class",
        "scale": {"range": ["#db6216", "#1750ad"]},
        "legend": {"orient": "bottom"}
      }
    }
  }, {
    "mark": {"type": "text", "opacity": 0.9, "color": "white"},
    "encoding": {
      "x": {
        "aggregate": "sum",
        "field": "prop",
        "type": "quantitative",
        "title": "Proportion",
        "stack":  "normalize",
        "bandPosition": 0.5
      },
      "text": {
        "field": "prop",
        "title": "Proportion"
      },
      "detail": {
        "field": "class"
      }
    }
  }]
}
